<?xml version="1.0"?>
<package format="3">
  <name>nontok_viz</name>
  <version>0.1.0</version>
  <description>Live dashboard: telemetry and camera views as a web page.</description>
  <maintainer email="todo@example.com">Nontok team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nontok_interfaces</exec_depend>
  <exec_depend>nontok_localization</exec_depend>
  <exec_depend>nontok_navigation</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
